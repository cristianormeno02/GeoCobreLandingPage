---
import { Image } from 'astro:assets';
import { type Partner, partners as defaultPartners } from '../data/partners';
import { type Locale, t } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Locale;
  partners?: Partner[];
}

const { lang, partners = defaultPartners } = Astro.props;
const dict = t(lang).alliances;
const types = [dict.types.labs, dict.types.government, dict.types.mining, dict.types.universities];
---

<section id="alianzas" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <SectionHeader title={dict.title} intro={dict.intro} />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        types.map((type) => (
          <li class="rounded-xl border-t-4 border-copper-600 bg-mineral-50 p-6">
            <h3 class="text-lg font-semibold text-slate-950">{type.title}</h3>
            <p class="mt-2 leading-relaxed text-slate-600">{type.text}</p>
          </li>
        ))
      }
    </ul>

    {
      partners.length > 0 && (
        <div class="mt-12">
          <h3 class="text-xl font-semibold text-slate-950">{dict.partnersTitle}</h3>
          <ul class="mt-6 flex flex-wrap items-center gap-8">
            {partners.map((partner) => {
              const logo = <Image src={partner.logo} alt={partner.name} height={64} class="h-16 w-auto" />;
              return <li>{partner.url ? <a href={partner.url} rel="noopener noreferrer" target="_blank">{logo}</a> : logo}</li>;
            })}
          </ul>
        </div>
      )
    }

    <a
      href="?tipo=alliance#contacto"
      class="mt-10 inline-flex min-h-11 items-center rounded-md bg-slate-950 px-5 font-semibold text-white hover:bg-copper-700"
    >
      {dict.cta}
    </a>
  </div>
</section>
