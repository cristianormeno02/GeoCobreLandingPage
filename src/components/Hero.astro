---
import { type Locale, t } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { hero } = t(lang);
---

<section id="inicio" class="relative isolate overflow-hidden bg-slate-950 text-white">
  <!-- Curvas de nivel decorativas -->
  <svg
    class="absolute inset-0 -z-10 h-full w-full opacity-20"
    viewBox="0 0 800 600"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <g fill="none" stroke="#c86432" stroke-width="1.2">
      <path d="M-50 480c120-60 210 20 330-30s170-150 300-120 190 80 280 40"></path>
      <path d="M-50 430c130-50 200 10 320-40s180-140 300-110 180 70 290 30"></path>
      <path d="M-50 380c140-40 190 0 310-50s190-130 300-100 170 60 300 20"></path>
      <path d="M-50 330c150-30 180-10 300-60s200-120 300-90 160 50 310 10"></path>
      <path d="M-50 280c160-20 170-20 290-70s210-110 300-80 150 40 320 0"></path>
      <path d="M520 90c40-30 110-20 120 20s-40 70-90 60-60-50-30-80z"></path>
      <path d="M545 100c25-15 70-10 75 15s-25 40-55 35-40-30-20-50z"></path>
    </g>
  </svg>

  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:py-32">
    <div class="max-w-3xl">
      <ul class="mb-8 flex flex-wrap gap-3">
        <li class="flex items-center gap-3 rounded-full border border-copper-400/40 bg-white/5 py-1.5 pr-4 pl-1.5">
          <span class="rounded-full bg-copper-400 px-3 py-1 text-sm font-bold text-slate-950">{hero.badgeTrl}</span>
          <span class="text-sm text-quartz-200">{hero.badgeTrlHint}</span>
        </li>
        <li class="flex items-center gap-2 rounded-full border border-copper-400/40 bg-white/5 px-4 py-1.5">
          <svg class="size-4 text-copper-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z"
            ></path>
          </svg>
          <span class="text-sm font-medium text-quartz-200">{hero.badgeValidated}</span>
        </li>
      </ul>

      <h1 class="text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">
        {hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-quartz-200">{hero.subtitle}</p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#contacto"
          class="inline-flex min-h-12 items-center rounded-md bg-copper-400 px-6 font-semibold text-slate-950 hover:bg-white"
        >
          {hero.ctaPrimary}
        </a>
        <a
          href="#servicios"
          class="inline-flex min-h-12 items-center rounded-md border border-white/40 px-6 font-semibold text-white hover:border-white hover:bg-white/10"
        >
          {hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>
