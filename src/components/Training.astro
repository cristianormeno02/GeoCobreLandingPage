---
import { type Course, courses as defaultCourses } from '../data/courses';
import { type Locale, t } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Locale;
  courses?: Course[];
}

const { lang, courses = defaultCourses } = Astro.props;
const dict = t(lang).training;
---

<section id="capacitacion" class="bg-mineral-50">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <SectionHeader title={dict.title} intro={dict.intro} />

    {
      courses.length > 0 ? (
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {courses.map((course) => (
            <article class="flex flex-col rounded-xl border border-quartz-200 bg-white p-6">
              <h3 class="text-lg font-semibold text-slate-950">{course.title[lang]}</h3>
              <p class="mt-1 text-sm font-medium text-copper-700">
                {dict.modality}: {course.modality[lang]}
              </p>
              <p class="mt-3 flex-1 leading-relaxed text-slate-600">{course.description[lang]}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-12 max-w-2xl rounded-xl border border-dashed border-copper-600 bg-white p-6 md:p-8">
          <h3 class="text-xl font-semibold text-slate-950">{dict.emptyTitle}</h3>
          <p class="mt-2 leading-relaxed text-slate-600">{dict.emptyText}</p>
        </div>
      )
    }

    <a
      href="?tipo=training#contacto"
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-slate-950 px-5 font-semibold text-white hover:bg-copper-700"
    >
      {dict.cta}
    </a>
  </div>
</section>
