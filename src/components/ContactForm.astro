---
import { INQUIRY_TYPES } from '../data/services';
import { site } from '../data/site';
import { type Locale, getLocalizedPath, t } from '../i18n/utils';
import { WEB3FORMS_ENDPOINT } from '../lib/submit';
import { MESSAGE_MIN_LENGTH } from '../lib/validation';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const { contact } = dict;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const redirect = new URL(getLocalizedPath(lang, 'thanks'), Astro.site).href;

const inputClass =
  'mt-2 block w-full rounded-md border border-slate-400 bg-white px-3 py-2.5 text-slate-950 placeholder:text-slate-500 focus:border-copper-700 aria-invalid:border-red-700';
const labelClass = 'block font-medium text-slate-950';
const errorClass = 'mt-1 text-sm font-medium text-red-700';
---

<section id="contacto" class="bg-mineral-50">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:py-24 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <SectionHeader title={contact.title} intro={contact.intro} />
      <ul class="mt-8 space-y-2">
        <li>
          <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center font-semibold text-copper-700 hover:text-slate-950">
            {site.email}
          </a>
        </li>
      </ul>
    </div>

    <form
      action={WEB3FORMS_ENDPOINT}
      method="POST"
      class="grid gap-5 rounded-xl border border-quartz-200 bg-white p-6 sm:grid-cols-2 md:p-8 lg:col-span-3"
      data-contact-form
      data-lang={lang}
      data-access-key={accessKey}
      data-subject={contact.subject}
      data-errors={JSON.stringify(contact.errors)}
      data-sending={contact.sending}
      data-submit={contact.submit}
    >
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value={contact.subject} />
      <input type="hidden" name="redirect" value={redirect} />
      <input type="hidden" name="lang" value={lang} />

      <!-- Campo trampa anti-spam: oculto para personas y tecnologías de apoyo -->
      <div class="hidden" aria-hidden="true">
        <label>Botcheck <input type="text" name="botcheck" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div>
        <label for="contact-name" class={labelClass}>{contact.fields.name}</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required class={inputClass} />
        <p id="contact-name-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="contact-email" class={labelClass}>{contact.fields.email}</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required class={inputClass} />
        <p id="contact-email-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="contact-company" class={labelClass}>
          {contact.fields.company} <span class="font-normal text-slate-600">({contact.optional})</span>
        </label>
        <input id="contact-company" name="company" type="text" autocomplete="organization" class={inputClass} />
      </div>

      <div>
        <label for="contact-country" class={labelClass}>
          {contact.fields.country} <span class="font-normal text-slate-600">({contact.optional})</span>
        </label>
        <input id="contact-country" name="country" type="text" autocomplete="country-name" class={inputClass} />
      </div>

      <div class="sm:col-span-2">
        <label for="contact-type" class={labelClass}>{contact.fields.type}</label>
        <select id="contact-type" name="type" required class={inputClass}>
          <option value="">{contact.typePlaceholder}</option>
          {INQUIRY_TYPES.map((type) => <option value={type}>{contact.typeOptions[type]}</option>)}
        </select>
        <p id="contact-type-error" class={errorClass} hidden></p>
      </div>

      <div class="sm:col-span-2">
        <label for="contact-message" class={labelClass}>{contact.fields.message}</label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          minlength={MESSAGE_MIN_LENGTH}
          placeholder={contact.messagePlaceholder}
          class={inputClass}></textarea>
        <p id="contact-message-error" class={errorClass} hidden></p>
      </div>

      <div class="sm:col-span-2">
        <div class="flex items-start gap-3">
          <input
            id="contact-consent"
            name="consent"
            type="checkbox"
            value="yes"
            required
            class="mt-1 size-5 shrink-0 accent-copper-700"
          />
          <label for="contact-consent" class="text-slate-700">
            {contact.fields.consent}
            <a href={getLocalizedPath(lang, 'privacy')} class="font-semibold text-copper-700 underline hover:text-slate-950">
              {contact.fields.consentLink}</a
            >.
          </label>
        </div>
        <p id="contact-consent-error" class={errorClass} hidden></p>
      </div>

      <div class="sm:col-span-2">
        <button
          type="submit"
          class="inline-flex min-h-12 items-center rounded-md bg-copper-700 px-6 font-semibold text-white hover:bg-slate-950 disabled:cursor-wait disabled:opacity-70"
        >
          {contact.submit}
        </button>
      </div>

      <div role="status" aria-live="polite" class="sm:col-span-2 empty:hidden" data-form-status></div>

      <template data-success-template>
        <p class="rounded-md bg-green-50 p-4 font-medium text-green-900">{contact.success}</p>
      </template>
      <template data-error-template>
        <div class="rounded-md bg-red-50 p-4 text-red-900">
          <p class="font-medium">{contact.error}</p>
          <ul class="mt-2 flex flex-wrap gap-x-6">
            <li><a href={`mailto:${site.email}`} class="underline">{site.email}</a></li>
            <li>
              <a href={buildWhatsAppUrl(site.whatsapp, dict.whatsapp.message)} target="_blank" rel="noopener noreferrer" class="underline">
                WhatsApp
              </a>
            </li>
          </ul>
        </div>
      </template>
    </form>
  </div>
</section>

<script>
  import { submitContact } from '../lib/submit';
  import { type ContactData, type ContactField, type ErrorCode, validateContact } from '../lib/validation';
  import { INQUIRY_TYPES } from '../data/services';
  import type { Locale } from '../i18n/utils';

  const FIELDS: ContactField[] = ['name', 'email', 'type', 'message', 'consent'];

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    // Con JavaScript validamos nosotros; sin él, actúa la validación nativa.
    form.noValidate = true;

    const errorMessages = JSON.parse(form.dataset.errors ?? '{}') as Record<ErrorCode, string>;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const control = (field: string) => form.elements.namedItem(field) as HTMLInputElement;
    let attempted = false;

    const preselected = new URLSearchParams(window.location.search).get('tipo');
    if (preselected && (INQUIRY_TYPES as readonly string[]).includes(preselected)) {
      control('type').value = preselected;
    }

    // Los CTA "?tipo=…#contacto" preseleccionan el tipo sin recargar la página.
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="?tipo="]');
      if (!link) return;
      const type = new URL(link.href).searchParams.get('tipo');
      if (!type || !(INQUIRY_TYPES as readonly string[]).includes(type)) return;
      event.preventDefault();
      control('type').value = type;
      history.pushState(null, '', link.href);
      document.getElementById('contacto')?.scrollIntoView();
      control('name').focus({ preventScroll: true });
    });

    const readData = (): ContactData => ({
      name: control('name').value,
      email: control('email').value,
      company: control('company').value,
      country: control('country').value,
      type: control('type').value,
      message: control('message').value,
      consent: control('consent').checked,
    });

    const showErrors = (errors: Partial<Record<ContactField, ErrorCode>>) => {
      for (const field of FIELDS) {
        const input = control(field);
        const errorEl = form.querySelector<HTMLElement>(`#contact-${field}-error`)!;
        const code = errors[field];
        if (code) {
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', errorEl.id);
          errorEl.textContent = errorMessages[code];
          errorEl.hidden = false;
        } else {
          input.removeAttribute('aria-invalid');
          input.removeAttribute('aria-describedby');
          errorEl.textContent = '';
          errorEl.hidden = true;
        }
      }
    };

    const showStatus = (template: 'success' | 'error') => {
      const content = form.querySelector<HTMLTemplateElement>(`[data-${template}-template]`)!.content;
      status.replaceChildren(content.cloneNode(true));
    };

    form.addEventListener('input', () => {
      if (attempted) showErrors(validateContact(readData()));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      attempted = true;
      status.replaceChildren();

      const data = readData();
      const errors = validateContact(data);
      showErrors(errors);
      const firstInvalid = FIELDS.find((field) => errors[field]);
      if (firstInvalid) {
        control(firstInvalid).focus();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = form.dataset.sending ?? '';

      const result = await submitContact(
        { ...data, lang: form.dataset.lang as Locale, botcheck: control('botcheck').value },
        { accessKey: form.dataset.accessKey ?? '', subject: form.dataset.subject ?? '' },
      );

      submitButton.disabled = false;
      submitButton.textContent = form.dataset.submit ?? '';

      if (result.status === 'error') {
        showStatus('error');
        return;
      }
      form.reset();
      attempted = false;
      showStatus('success');
    });
  }
</script>
