---
import { Image } from 'astro:assets';
import { type TeamMember, team as defaultTeam } from '../data/team';
import { type Locale, t } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';

interface Props {
  lang: Locale;
  team?: TeamMember[];
}

const { lang, team = defaultTeam } = Astro.props;
const dict = t(lang).team;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((word) => /^\p{Lu}/u.test(word))
    .slice(0, 2)
    .map((word) => word[0])
    .join('');
---

<section id="equipo" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <SectionHeader title={dict.title} intro={dict.intro} />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member) => (
          <article class="rounded-xl border border-quartz-200 p-6">
            {member.photo ? (
              <Image
                src={member.photo}
                alt={`${dict.photoAlt} ${member.name}`}
                width={160}
                height={160}
                class="size-20 rounded-full object-cover"
              />
            ) : (
              <span class="flex size-20 items-center justify-center rounded-full bg-slate-950 text-2xl font-bold text-copper-400" aria-hidden="true">
                {initials(member.name) || 'GC'}
              </span>
            )}
            <h3 class="mt-4 text-lg font-semibold text-slate-950">{member.name}</h3>
            <p class="font-medium text-copper-700" data-role>{member.role[lang]}</p>
            <p class="mt-2 text-slate-600" data-specialty>{member.specialty[lang]}</p>
            <p class="mt-1 text-sm text-slate-600">{member.education[lang]}</p>
            {member.linkedin && (
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${dict.linkedinLabel} ${member.name}`}
                class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-copper-700 hover:underline"
              >
                <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0h.01Z" />
                </svg>
                LinkedIn
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
