---
import '../styles/global.css';
import { site } from '../data/site';
import { type Locale, type RouteKey, getAlternates, getLocalizedPath, t } from '../i18n/utils';

interface Props {
  lang: Locale;
  /** Página actual, para canonical y hreflang. Sin valor, la página no tiene alternativas (p. ej. 404). */
  route?: RouteKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, route, title, description, noindex = false } = Astro.props;
const dict = t(lang);
const siteUrl = Astro.site!.href;
const pageTitle = title ? `${title} | ${site.name}` : dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const canonical = route ? new URL(getLocalizedPath(lang, route), siteUrl).href : undefined;
const alternates = route ? getAlternates(route, siteUrl) : [];
const ogImage = new URL('/og-default.png', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: canonical ?? siteUrl,
  email: site.email,
  description: dict.meta.description,
  image: ogImage,
  inLanguage: lang,
  areaServed: site.country,
  knowsAbout: ['Geology', 'Mineral exploration', 'Petrography', 'Drill core logging', 'Ore deposits'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical ?? siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dict.meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
